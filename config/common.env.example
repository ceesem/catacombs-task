# Template for config/common.env — copy to config/common.env and fill in.
#
# config/common.env is git-ignored because it carries infra identifiers (GCP
# project, VPC). Only this .example lives in the repo. See config/README.md.
#
# Shared defaults, layered UNDER every profile in config/<env>/.
#
# Loaded FIRST by every `poe` task (via `uv run --env-file` and
# scripts/process_template.sh), so anything a profile re-declares in its own
# task.env / cluster.env wins. Put here only what is the same across datasets;
# put dataset- or server-specific values in config/<env>/.

TQ_LEASE_SECONDS=300

# --- GKE cluster machinery (same GCP account for every dataset) ---
GOOGLE_PROJECT_NAME=<GCP_PROJECT>
GOOGLE_VPC_NETWORK_NAME=<VPC_NETWORK>
GOOGLE_ZONE=us-west1-a
GOOGLE_SUBNETWORK_REGION=us-west1
GOOGLE_COMPUTE_TYPE=e2-standard-4
NUMBER_NODES=1
PODS_PER_NODE=256

# --- worker image + fan-out (same code for every dataset) ---
TASK_DOCKER_IMAGE=<DOCKERHUB_NAMESPACE>/catacombs-task:v1
TASK_REPLICAS=18

# --- per-pod resource requests / limits ---
MEMORY_REQUEST=400Mi   # min memory to schedule a pod
CPU_REQUEST=100m       # min CPU (millicores; 1000m = 1 core)
EPHEMERAL_STORAGE_REQUEST=1Gi
MEMORY_LIMIT=600Mi     # pod killed if it exceeds this
EPHEMERAL_STORAGE_LIMIT=2Gi
