# --- Live per-run configs (profile-per-run convention) ---
# Real profiles under config/<profile>/ and the live config/common.env carry
# infra identifiers (AWS account, GCS buckets, GCP project, VPC). Keep only the
# templates in git: config/examples/ and config/common.env.example.
/config/*/
!/config/examples/
/config/common.env

# --- Rendered cluster scripts ---
# Rendered per profile into config/<profile>/scripts/ by process_template.sh
# (poe make_scripts). They carry the live profile's identifiers and are already
# covered by the /config/*/ rule above; the templates/ sources (which use
# ${PLACEHOLDER} vars) stay in git.
